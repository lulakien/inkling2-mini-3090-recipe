+def _init_host_allreduce(cpu_group, ranks, rank_in_group, device, cap=None, blocks=None, what="all-reduce"):
+    """sm8x patch: set up the TP2 host-memory all-reduce / all-gather (/hostar/hostar.py)."""
+    import sys
+    import uuid
+
+    import torch.distributed as dist
+
+    sys.path.insert(0, os.environ.get("VLLM_HOST_ALLREDUCE_DIR", "/hostar"))
+    from hostar import HostAllReduce, create_shm
+
+    if cap is None:
+        cap = int(os.environ.get("VLLM_HOST_ALLREDUCE_MAX_BYTES", str(16 * 8192 * 2)))
+    if blocks is None:
+        blocks = int(os.environ.get("VLLM_HOST_ALLREDUCE_BLOCKS", "4"))
+    name = [f"vllm_hostar_{uuid.uuid4().hex[:12]}" if rank_in_group == 0 else None]
+    dist.broadcast_object_list(name, src=ranks[0], group=cpu_group)
+    if rank_in_group == 0:
+        create_shm(name[0], cap)
+    dist.barrier(group=cpu_group)
+    torch.cuda.set_device(device)
+    har = HostAllReduce(name[0], rank_in_group, cap, device, blocks=blocks)
+    dist.barrier(group=cpu_group)
+    if rank_in_group == 0:
+        os.unlink(f"/dev/shm/{name[0]}")
+    logger.info("Host-memory TP2 %s enabled (max %d bytes, %d CTAs)", what, cap, blocks)
+    return har
+
+def _init_cear(cpu_group, ranks, rank_in_group, device):
+    """sm8x patch: copy-engine TP2 all-reduce for prefill pieces (/hostar/cear.py)."""
+    import sys
+    import uuid
+
+    import torch.distributed as dist
+
+    sys.path.insert(0, os.environ.get("VLLM_HOST_ALLREDUCE_DIR", "/hostar"))
+    from cear import CopyEngineAllReduce, create_shm
+
+    cap = int(os.environ.get("VLLM_CEAR_MAX_BYTES", str(24 << 20)))
+    name = [f"vllm_cear_{uuid.uuid4().hex[:12]}" if rank_in_group == 0 else None]
+    dist.broadcast_object_list(name, src=ranks[0], group=cpu_group)
+    if rank_in_group == 0:
+        create_shm(name[0], cap)
+    dist.barrier(group=cpu_group)
+    torch.cuda.set_device(device)
+    ce = CopyEngineAllReduce(name[0], rank_in_group, cap, device)
+    dist.barrier(group=cpu_group)
+    if rank_in_group == 0:
+        os.unlink(f"/dev/shm/{name[0]}")
+    logger.info("Copy-engine TP2 all-reduce for prefill MoE pieces enabled (max %d bytes)", cap)
+    return ce
+
