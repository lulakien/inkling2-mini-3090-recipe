 from .ops.linear import linear
 
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def _w8_draft_linear(
+    x: torch.Tensor, proj: nn.Module, out_dtype: torch.dtype | None = None
+) -> torch.Tensor:
+    """sm8x patch: int8 per-channel draft-layer GEMMs (VLLM_INKLING_W8 contains
+    "draft"); bf16 `linear` when the switch is off or before the weight has been
+    quantized (a capture that runs before the first eager use).
+
+    Two distinct one-shot log lines make the boot-time outcome visible:
+    "quantized" means the int8 path is captured; "not yet quantized" means the
+    capture is running the bf16 fallback (no speedup, output still valid)."""
+    from .ops.w8_gemm import W8, get_w8, w8_linear
+
+    if "draft" in W8:
+        w8 = get_w8(proj)
+        if w8 is not None:
+            logger.info_once("inkling2 draft W8: draft projections quantized to int8")
+            return w8_linear(x, w8, out_dtype=out_dtype)
+        logger.info_once(
+            "inkling2 draft W8: weight not yet quantized, bf16 fallback (no speedup)"
+        )
+    return linear(x, proj.weight)
+
 
