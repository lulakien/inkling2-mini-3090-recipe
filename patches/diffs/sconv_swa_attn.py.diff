+# sm8x recipe patch (VLLM_SCONV_TAIL=1), adapted from HyperInkling (Pento95, Apache-2.0):
+# the conv reads cached taps only for the first W-1 tokens of a step, so a step needs real blocks only for its
+# tail (the window, drafts in flight, one prefix-hit alignment); the rest of a prefill chunk maps to the null block.
+_SCONV_TAIL = os.environ.get("VLLM_SCONV_TAIL", "0") == "1"
+
+
+class SconvStateManager(DFlashSlidingWindowManager):
+    """Conv-state cache that backs only each step's tail (see the note above)."""
+
+    @_dataclass(frozen=True, slots=True)
+    class Params(DFlashSlidingWindowManager.Params):
+        hit_alignment_tokens: int = 0
+
+        @property
+        def tail_tokens(self) -> int:
+            return (
+                self.sliding_window
+                + self.num_speculative_tokens * self.max_in_flight_steps
+                + self.hit_alignment_tokens
+            )
+
+    find_longest_cache_hit = SlidingWindowManager.__dict__["find_longest_cache_hit"]
+    reachable_block_mask = SlidingWindowManager.__dict__["reachable_block_mask"]
+
+    def __init__(self, kv_cache_group, **kwargs) -> None:
+        super().__init__(kv_cache_group, **kwargs)
+        params = self.manager_config.params
+        assert isinstance(params, SconvStateManager.Params)
+        assert self.cache_hit_alignment_tokens <= params.hit_alignment_tokens, (
+            "conv-state tails shorter than the prefix-hit alignment"
+        )
+
