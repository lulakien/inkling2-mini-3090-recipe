+        # sm8x patch: VLLM_INKLING_EMBED_HOST=1 moves the input embedding table (0.86 GiB bf16, shared with the
+        # drafter) to pinned host memory, read in place over PCIe through a UVA device view: a step gathers only
+        # its tokens' rows (a 1024-token prefill chunk = 4.7 MB), so the freed VRAM goes to the KV cache.
+        import os
+
+        if os.environ.get("VLLM_INKLING_EMBED_HOST") != "1":
