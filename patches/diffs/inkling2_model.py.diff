 class Inkling2LogitsProcessor(LogitsProcessor):
     """Use the low-M projection while preserving vocab gathering and softcaps."""
 
+    def forward(self, lm_head, hidden_states, embedding_bias=None, skip_gather=False):
+        # sm8x patch: the same softcap ops in place (bit-identical), so a 512-row prompt-logprob chunk holds one
+        # [rows, vocab] fp32 buffer instead of two (the KV cache is sized after warmup's peak).
+        if self.logits_as_input:
+            return super().forward(lm_head, hidden_states, embedding_bias, skip_gather)
+        logits = self._get_logits(hidden_states, lm_head, embedding_bias, skip_gather)
+        if logits is not None:
+            if self.soft_cap is not None:
+                logits.div_(self.soft_cap).tanh_().mul_(self.soft_cap)
+            if self.scale != 1.0:
+                logits *= self.scale
+        return logits
+
